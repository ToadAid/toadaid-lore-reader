---
import '../../styles/reader.css';
import { loadGeneratedArchive } from '../../lib/lore/archive-cover-state';
import { orderedRecords, recordRoute } from '../../lib/lore/reader-model';
import { renderMarkdown } from '../../lib/lore/markdown';
import { loadMediaReaderState, renderItemsForRecord, mediaKindLabel, type MediaRenderItem } from '../../lib/lore/media-reader-state';

// Stage 2A-P2M2 — Historical Media rendering. The generated archive is proven
// against canonical constants by loadGeneratedArchive(); the generated media
// interpretation is proven to belong to the exact same generation (and to be the
// exact deterministic derivation of the snapshot) by loadMediaReaderState(), which
// reuses the sealed P2M1 validator. Composition proves manifest == CANONICAL.
// When no generated archive exists (clean checkout) getStaticPaths returns [],
// so no record page is emitted and there is nothing to render media for.
export function getStaticPaths() {
  const archive = loadGeneratedArchive();
  if (archive.status === 'unavailable') return [];
  const media = loadMediaReaderState();
  const byId = media.status === 'verified' ? media.byId : null;
  return orderedRecords(archive.records).map((record, index, records) => {
    const interp = byId ? byId.get(record.canonicalId) : undefined;
    const mediaItems = renderItemsForRecord(interp);
    return { params: { canonicalId: record.canonicalId }, props: { record, previous: records[index - 1] ?? null, next: records[index + 1] ?? null, provenance: archive.provenance, mediaItems } };
  });
}
const { record, previous, next, provenance, mediaItems } = Astro.props as { record: any; previous: any; next: any; provenance: any; mediaItems: MediaRenderItem[] };
const hasOriginal = typeof record.canonical.original === 'string' && record.canonical.original.length > 0;
const originalHtml = hasOriginal ? renderMarkdown(record.canonical.original as string) : '';
const commentaryHtml = renderMarkdown(record.canonical.comment);
const sourceUrl = typeof record.canonical.url === 'string' && record.canonical.url.length > 0 ? record.canonical.url : null;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{record.canonical.title} · The Pond Archive</title></head>
<body><main class="chapter-shell"><header class="reader-header"><a href="/chronicle/">← RIPPLE CHRONICLE</a><span><a href="/bookmarks/">Bookmarks</a> · THE POND ARCHIVE</span></header><article class="chapter-article">
<p class="kicker">ARCHIVE DATE · {record.chronology.archiveChronologyMarker}</p>
<h1>{record.canonical.title}</h1>
<p class="canonical-id">◉ CANONICAL RECORD · {record.canonicalId}</p>
<div class="record-actions">{!hasOriginal && sourceUrl ? <a class="source-link source-link--top" href={sourceUrl} target="_blank" rel="noreferrer">Source ↗</a> : null}<button type="button" class="record-action" data-bookmark-id={record.canonicalId} aria-pressed="false" aria-label={`Bookmark ${record.canonical.title}`}>Bookmark</button><button type="button" class="record-action" data-share-url={recordRoute(record.canonicalId)} aria-label="Share this record">Share</button><span class="record-action-status" data-share-status="" role="status"></span></div>
<div class="mode-controls" role="group" aria-label="Reading mode">{hasOriginal ? <button type="button" data-mode="original" aria-pressed="false">Original</button> : null}<button type="button" data-mode="commentary" aria-pressed="false">Commentary</button><button type="button" data-mode="both" aria-pressed="true">Both</button></div>

{hasOriginal ? <section class="original-folio" data-evidence-section="original" aria-label="Original Record"><p class="folio-label">Original Record</p><div class="folio-body folio-body--source" set:html={originalHtml} />{sourceUrl ? <p class="folio-source"><a class="source-link" href={sourceUrl} target="_blank" rel="noreferrer">Source ↗</a></p> : null}</section> : null}

<section class="commentary-folio" data-evidence-section="commentary" aria-label="Commentary"><p class="folio-label folio-label--muted">Commentary</p><div class="folio-body folio-body--commentary" set:html={commentaryHtml} /></section>

{mediaItems.length > 0 ? <section class="historical-media" aria-label="Historical Media"><p class="folio-label folio-label--muted">Historical Media</p><p class="media-note">Referenced by this lore record. Preservation not asserted.</p><ul class="media-list">{mediaItems.map((item, i) => <li class={`media-item media-item--${item.mode}`} data-media-mode={item.mode}>{item.mode === 'image' ? <span class="media-inline"><img class="media-img" src={item.safeHref} alt="" loading="lazy" decoding="async" data-media-img="1" data-fallback-id={`media-fb-${i}`} /><a class="source-link media-fallback" id={`media-fb-${i}`} hidden href={item.safeHref} target="_blank" rel="noreferrer">External media reference ({mediaKindLabel(item.kind)}) ↗</a></span> : item.mode === 'video' ? <span class="media-inline"><video class="media-video" controls preload="none" aria-label="External media reference"><source src={item.safeHref} /></video><a class="source-link media-ref" href={item.safeHref} target="_blank" rel="noreferrer">External media reference (video) ↗</a></span> : item.mode === 'audio' ? <span class="media-inline"><audio class="media-audio" controls preload="none" aria-label="External media reference"><source src={item.safeHref} /></audio><a class="source-link media-ref" href={item.safeHref} target="_blank" rel="noreferrer">External media reference (audio) ↗</a></span> : item.mode === 'youtube' ? <span class="media-youtube"><button class="source-link media-yt-load" type="button" data-yt-embed={item.embedUrl} data-yt-id={item.videoId}>Load YouTube player</button><a class="source-link" href={item.safeHref} target="_blank" rel="noreferrer">Open on YouTube ↗</a></span> : item.mode === 'link' ? <a class="source-link" href={item.safeHref} target="_blank" rel="noreferrer">External media reference ({mediaKindLabel(item.kind)}) ↗</a> : <span class="media-text break">{item.reference}</span>}</li>)}</ul></section> : null}

<details class="evidence"><summary>Evidence Lens</summary><div><h2>Record-level evidence</h2><dl><dt>Canonical record ID</dt><dd>{record.canonicalId}</dd><dt>Archive date</dt><dd>{record.chronology.archiveChronologyMarker} — chronology marker, not asserted publication timestamp.</dd><dt>Title</dt><dd>{record.canonical.title}</dd>{sourceUrl ? <><dt>Source URL</dt><dd class="break"><a href={sourceUrl} target="_blank" rel="noreferrer">{sourceUrl}</a></dd></> : null}</dl><h2>Snapshot-level provenance</h2><dl><dt>Repository</dt><dd>{provenance.repository}</dd><dt>Path</dt><dd>{provenance.path}</dd><dt>Commit</dt><dd class="break">{provenance.commit}</dd><dt>Source digest</dt><dd class="break">{provenance.sourceDigest}</dd><dt>Record count</dt><dd>{provenance.recordCount}</dd></dl></div></details>

<nav class="chapter-nav" aria-label="Chronological record navigation">{previous ? <a href={recordRoute(previous.canonicalId)}>← Previous record</a> : <span />}{next ? <a href={recordRoute(next.canonicalId)}>Next record →</a> : <span />}</nav>{!next ? <p class="continues">The Lore Continues…</p> : null}</article></main><script is:inline>
// Stage 2A-P2M2 — reading-mode + Historical Media runtime. Real executable
// statements (NOT a template-literal expression): authored directly so the
// built HTML contains runnable JavaScript, not an inert `{`...`}` string.
document.querySelectorAll('[data-mode]').forEach((button) => button.addEventListener('click', () => { const mode = button.dataset.mode; document.querySelectorAll('[data-mode]').forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.mode === mode))); document.querySelectorAll('[data-evidence-section]').forEach((section) => { section.hidden = mode !== 'both' && section.dataset.evidenceSection !== mode; }); }));
// Stage 2A-P2M2 — Historical Media runtime. No network until the user acts.
// YouTube: click-to-load privacy-conscious nocookie iframe (lazy, no autoplay,
// sensible referrer policy). Before activation no YouTube request is made.
document.querySelectorAll('.media-yt-load').forEach((btn) => { btn.addEventListener('click', () => { const embed = btn.dataset.ytEmbed; if (!embed || !embed.startsWith('https://www.youtube-nocookie.com/embed/')) return; const iframe = document.createElement('iframe'); iframe.src = embed; iframe.loading = 'lazy'; iframe.title = 'YouTube video player'; iframe.allow = 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'; iframe.referrerPolicy = 'strict-origin-when-cross-origin'; iframe.setAttribute('allowfullscreen', ''); iframe.className = 'media-youtube-frame'; btn.replaceWith(iframe); }, { once: true }); });
// Inline images: graceful fallback to the external reference link when the
// remote asset does not load. No build-time fetch; this only reacts at runtime.
document.querySelectorAll('[data-media-img]').forEach((img) => { const reveal = () => { img.hidden = true; const fb = document.getElementById(img.dataset.fallbackId); if (fb) fb.hidden = false; }; img.addEventListener('error', reveal); if (img.complete && img.naturalWidth === 0) reveal(); });
// Stage 2A-P2U1 — Lore bookmark runtime. Browser-local localStorage only; stores
// only an ordered array of canonicalId strings (no title/content/provenance). Never
// throws and never breaks ordinary reading when storage is disabled/corrupt.
try { (function () {
  var KEY = 'toadaid:lore-reader:bookmarks:v1';
  function readIds() {
    var raw;
    try { if (typeof localStorage === 'undefined' || !localStorage) return null; raw = localStorage.getItem(KEY); }
    catch (e) { return null; }
    if (raw === null) return [];
    try { var p = JSON.parse(raw); } catch (e) { return null; }
    if (!Array.isArray(p)) return null;
    var seen = {};
    for (var i = 0; i < p.length; i++) {
      if (typeof p[i] !== 'string' || p[i].length === 0) return null;
      if (Object.prototype.hasOwnProperty.call(seen, p[i])) return null;
      seen[p[i]] = true;
    }
    return p;
  }
  var btn = document.querySelector('[data-bookmark-id]');
  if (!btn) return;
  var id = btn.dataset.bookmarkId;
  function reflect() {
    var ids = readIds();
    if (ids === null) { btn.setAttribute('aria-pressed', 'false'); btn.setAttribute('disabled', ''); btn.classList.add('is-degraded'); return; }
    btn.removeAttribute('disabled');
    btn.classList.remove('is-degraded');
    btn.setAttribute('aria-pressed', String(ids.indexOf(id) !== -1));
  }
  reflect();
  btn.addEventListener('click', function () {
    var ids = readIds();
    if (ids === null) return; // corrupt/unavailable: do not overwrite, do not claim success
    var next = ids.indexOf(id) === -1 ? ids.concat([id]) : ids.filter(function (e) { return e !== id; });
    try { localStorage.setItem(KEY, JSON.stringify(next)); } catch (e) { return; } // write failed: no false success
    reflect();
  });
})(); } catch (e) { /* bookmark runtime must never break reading */ }
// Stage 2A-P2U1 — individual-record Share. Prefers the native Web Share API; falls
// back to Copy Link. Sends ONLY the record URL — never canonical lore text or
// commentary. AbortError (user dismissal) never triggers a surprise clipboard copy.
try { (function () {
  var btn = document.querySelector('[data-share-url]');
  if (!btn) return;
  function status(text) { var s = document.querySelector('[data-share-status]'); if (s) s.textContent = text; }
  btn.addEventListener('click', function () {
    var path = btn.dataset.shareUrl;
    if (!path) return;
    var origin = (typeof location !== 'undefined' && location && location.origin) ? location.origin : '';
    var url = origin + path;
    function copyFallback() {
      try {
        if (typeof navigator === 'undefined' || !navigator || !navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') { status('Copy unavailable'); return; }
        var p = navigator.clipboard.writeText(url);
        if (p && typeof p.then === 'function') { p.then(function () { status('Link copied'); }, function () { status('Copy unavailable'); }); }
        else { status('Link copied'); }
      } catch (e) { status('Copy unavailable'); }
    }
    if (typeof navigator !== 'undefined' && navigator && typeof navigator.share === 'function') {
      var sp = navigator.share({ url: url });
      if (sp && typeof sp.then === 'function') {
        sp.then(function () { /* shared or dismissed; no clipboard copy after a share attempt */ }, function (err) {
          if (err && err.name === 'AbortError') return; // user cancelled: never surprise-copy
          copyFallback(); // a non-Abort failure may fall back to copy
        });
      }
      return;
    }
    copyFallback();
  });
})(); } catch (e) { /* share runtime must never break reading */ }
</script></body></html>