---
import '../../styles/reader.css';
import { loadGeneratedArchive } from '../../lib/lore/archive-cover-state';
import { orderedRecords, recordRoute } from '../../lib/lore/reader-model';
import { renderMarkdown } from '../../lib/lore/markdown';
import { loadMediaReaderState, renderItemsForRecord, mediaKindLabel, type MediaRenderItem } from '../../lib/lore/media-reader-state';

// Stage 2A-P2M2 — Historical Media rendering. The generated archive is proven
// against canonical constants by loadGeneratedArchive(); the generated media
// interpretation is proven to belong to the exact same generation (and to be the
// exact deterministic derivation of the snapshot) by loadMediaReaderState(), which
// reuses the sealed P2M1 validator. Composition proves manifest == CANONICAL.
// When no generated archive exists (clean checkout) getStaticPaths returns [],
// so no record page is emitted and there is nothing to render media for.
export function getStaticPaths() {
  const archive = loadGeneratedArchive();
  if (archive.status === 'unavailable') return [];
  const media = loadMediaReaderState();
  const byId = media.status === 'verified' ? media.byId : null;
  return orderedRecords(archive.records).map((record, index, records) => {
    const interp = byId ? byId.get(record.canonicalId) : undefined;
    const mediaItems = renderItemsForRecord(interp);
    return { params: { canonicalId: record.canonicalId }, props: { record, previous: records[index - 1] ?? null, next: records[index + 1] ?? null, provenance: archive.provenance, mediaItems } };
  });
}
const { record, previous, next, provenance, mediaItems } = Astro.props as { record: any; previous: any; next: any; provenance: any; mediaItems: MediaRenderItem[] };
const hasOriginal = typeof record.canonical.original === 'string' && record.canonical.original.length > 0;
const originalHtml = hasOriginal ? renderMarkdown(record.canonical.original as string) : '';
const commentaryHtml = renderMarkdown(record.canonical.comment);
const sourceUrl = typeof record.canonical.url === 'string' && record.canonical.url.length > 0 ? record.canonical.url : null;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{record.canonical.title} · The Pond Archive</title></head>
<body><main class="chapter-shell"><header class="reader-header"><a href="/chronicle/">← RIPPLE CHRONICLE</a><span>THE POND ARCHIVE</span></header><article class="chapter-article">
<p class="kicker">ARCHIVE DATE · {record.chronology.archiveChronologyMarker}</p>
<h1>{record.canonical.title}</h1>
<p class="canonical-id">◉ CANONICAL RECORD · {record.canonicalId}</p>
{!hasOriginal && sourceUrl ? <p><a class="source-link source-link--top" href={sourceUrl} target="_blank" rel="noreferrer">Source ↗</a></p> : null}
<div class="mode-controls" role="group" aria-label="Reading mode">{hasOriginal ? <button type="button" data-mode="original" aria-pressed="false">Original</button> : null}<button type="button" data-mode="commentary" aria-pressed="false">Commentary</button><button type="button" data-mode="both" aria-pressed="true">Both</button></div>

{hasOriginal ? <section class="original-folio" data-evidence-section="original" aria-label="Original Record"><p class="folio-label">Original Record</p><div class="folio-body folio-body--source" set:html={originalHtml} />{sourceUrl ? <p class="folio-source"><a class="source-link" href={sourceUrl} target="_blank" rel="noreferrer">Source ↗</a></p> : null}</section> : null}

<section class="commentary-folio" data-evidence-section="commentary" aria-label="Commentary"><p class="folio-label folio-label--muted">Commentary</p><div class="folio-body folio-body--commentary" set:html={commentaryHtml} /></section>

{mediaItems.length > 0 ? <section class="historical-media" aria-label="Historical Media"><p class="folio-label folio-label--muted">Historical Media</p><p class="media-note">Referenced by this lore record. Preservation not asserted.</p><ul class="media-list">{mediaItems.map((item, i) => <li class={`media-item media-item--${item.mode}`} data-media-mode={item.mode}>{item.mode === 'image' ? <span class="media-inline"><img class="media-img" src={item.safeHref} alt="" loading="lazy" decoding="async" data-media-img="1" data-fallback-id={`media-fb-${i}`} /><a class="source-link media-fallback" id={`media-fb-${i}`} hidden href={item.safeHref} target="_blank" rel="noreferrer">External media reference ({mediaKindLabel(item.kind)}) ↗</a></span> : item.mode === 'video' ? <video class="media-video" controls preload="none" aria-label="External media reference"><source src={item.safeHref} /></video> : item.mode === 'audio' ? <audio class="media-audio" controls preload="none" aria-label="External media reference"><source src={item.safeHref} /></audio> : item.mode === 'youtube' ? <span class="media-youtube"><button class="source-link media-yt-load" type="button" data-yt-embed={item.embedUrl} data-yt-id={item.videoId}>Load YouTube player</button><a class="source-link" href={item.safeHref} target="_blank" rel="noreferrer">Open on YouTube ↗</a></span> : item.mode === 'link' ? <a class="source-link" href={item.safeHref} target="_blank" rel="noreferrer">External media reference ({mediaKindLabel(item.kind)}) ↗</a> : <span class="media-text break">{item.reference}</span>}</li>)}</ul></section> : null}

<details class="evidence"><summary>Evidence Lens</summary><div><h2>Record-level evidence</h2><dl><dt>Canonical record ID</dt><dd>{record.canonicalId}</dd><dt>Archive date</dt><dd>{record.chronology.archiveChronologyMarker} — chronology marker, not asserted publication timestamp.</dd><dt>Title</dt><dd>{record.canonical.title}</dd>{sourceUrl ? <><dt>Source URL</dt><dd class="break"><a href={sourceUrl} target="_blank" rel="noreferrer">{sourceUrl}</a></dd></> : null}</dl><h2>Snapshot-level provenance</h2><dl><dt>Repository</dt><dd>{provenance.repository}</dd><dt>Path</dt><dd>{provenance.path}</dd><dt>Commit</dt><dd class="break">{provenance.commit}</dd><dt>Source digest</dt><dd class="break">{provenance.sourceDigest}</dd><dt>Record count</dt><dd>{provenance.recordCount}</dd></dl></div></details>

<nav class="chapter-nav" aria-label="Chronological record navigation">{previous ? <a href={recordRoute(previous.canonicalId)}>← Previous record</a> : <span />}{next ? <a href={recordRoute(next.canonicalId)}>Next record →</a> : <span />}</nav>{!next ? <p class="continues">The Lore Continues…</p> : null}</article></main><script is:inline>{`document.querySelectorAll('[data-mode]').forEach((button) => button.addEventListener('click', () => { const mode = button.dataset.mode; document.querySelectorAll('[data-mode]').forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.mode === mode))); document.querySelectorAll('[data-evidence-section]').forEach((section) => { section.hidden = mode !== 'both' && section.dataset.evidenceSection !== mode; }); }));
// Stage 2A-P2M2 — Historical Media runtime. No network until the user acts.
// YouTube: click-to-load privacy-conscious nocookie iframe (lazy, no autoplay,
// sensible referrer policy). Before activation no YouTube request is made.
document.querySelectorAll('.media-yt-load').forEach((btn) => { btn.addEventListener('click', () => { const embed = btn.dataset.ytEmbed; if (!embed) return; const iframe = document.createElement('iframe'); iframe.src = embed; iframe.loading = 'lazy'; iframe.title = 'YouTube video player'; iframe.allow = 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'; iframe.referrerPolicy = 'strict-origin-when-cross-origin'; iframe.setAttribute('allowfullscreen', ''); btn.replaceWith(iframe); }, { once: true }); });
// Inline images: graceful fallback to the external reference link when the
// remote asset does not load. No build-time fetch; this only reacts at runtime.
document.querySelectorAll('[data-media-img]').forEach((img) => { const reveal = () => { img.hidden = true; const fb = document.getElementById(img.dataset.fallbackId); if (fb) fb.hidden = false; }; img.addEventListener('error', reveal); if (img.complete && img.naturalWidth === 0) reveal(); });`}</script></body></html>