---
import '../styles/pond-archive.css';
import { loadArchiveCoverState } from '../lib/lore/archive-cover-state';
import { publicPath } from '../lib/public-site';

const archive = loadArchiveCoverState();
const verified = archive.status === 'verified';
const publicBase = import.meta.env.BASE_URL;
const publicPwa = import.meta.env.PUBLIC_PWA === '1';
const coverStyle = [
  `--archive-cover-desktop: url("${publicPath('/art/pond-archive/cover-desktop.png', publicBase)}")`,
  `--archive-cover-mobile: url("${publicPath('/art/pond-archive/cover-mobile.png', publicBase)}")`,
].join(';');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The Lore of Tobyworld — Preserved by ToadAid." />
    {publicPwa && <><link rel="manifest" href={publicPath('/manifest.webmanifest', publicBase)} /><meta name="theme-color" content="#101827" /><meta name="apple-mobile-web-app-capable" content="yes" /></>}
    <title>The Pond Archive · ToadAid Lore Reader</title>
  </head>
  <body>
    <main class="archive-cover" style={coverStyle}>
      <div class="moon" aria-hidden="true"></div>
      <div class="ripple ripple-one" aria-hidden="true"></div>
      <div class="ripple ripple-two" aria-hidden="true"></div>
      <div class="ripple ripple-three" aria-hidden="true"></div>
      <div class="pond-lights" aria-hidden="true">{Array.from({ length: 8 }, (_, index) => <i class={`pond-light pond-light-${index + 1}`}></i>)}</div>
      <div class="stars" aria-hidden="true">{Array.from({ length: 22 }, (_, index) => <i class={`star star-${index + 1} ${index < 14 ? 'star--faint' : index < 19 ? 'star--medium' : 'star--bright'}`}></i>)}</div>

      <nav class="wordmark" aria-label="ToadAid Lore Reader">
        <span class="wordmark-mark">◉</span>
        <span>TOADAID</span>
        <span class="wordmark-divider">/</span>
        <span>LORE READER</span>
      </nav>

      <section class="cover-copy" aria-labelledby="archive-title">
        <p class="eyebrow">A GOVERNED HISTORICAL READER</p>
        <h1 id="archive-title">THE<br />POND ARCHIVE</h1>
        <p class="promise">The Lore of Tobyworld <span>—</span> Preserved by ToadAid</p>
        <p class="intro">A quiet place to read canonical lore, inspect its evidence, and follow every ripple back to its source.</p>

        {verified ? (
          <section class="archive-state verified-state" aria-label="Verified canonical archive state">
            <p class="record-count">Verified canonical archive</p>
            <p class="snapshot-status"><span class="status-dot" aria-hidden="true"></span> Canonical snapshot <code aria-label={`Canonical commit ${archive.canonicalCommit}`}>{archive.canonicalCommit.slice(0, 9)}…</code></p>
            <a class="enter-archive" href={publicPath('/chronicle/', publicBase)}>Enter the Archive <span aria-hidden="true">→</span></a>
          </section>
        ) : (
          <p class="snapshot-status unavailable-state"><span class="status-dot" aria-hidden="true"></span> Awaiting a verified canonical snapshot</p>
        )}
      </section>

      <aside class="source-note" aria-label="Archive status">
        <span>◉ CANONICAL ARCHIVE</span>
        <p>{verified ? `Verified from ${archive.repository}/${archive.path}.` : 'Every chapter will retain its source, canonical identity, chronology marker, and provenance.'}</p>
      </aside>

      <p class="cover-footnote">THE ARCHIVE IS QUIET. THE LORE CONTINUES.</p>
    </main>
    {publicPwa && <script is:inline define:vars={{ serviceWorkerUrl: publicPath('/sw.js', publicBase) }}>if ('serviceWorker' in navigator) { window.addEventListener('load', () => navigator.serviceWorker.register(serviceWorkerUrl, { scope: new URL(serviceWorkerUrl, location.href).pathname.replace(/sw\.js$/, '') })); }</script>}
  </body>
</html>
